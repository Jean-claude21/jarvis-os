# Copy to .env (never committed), or let `pnpm provision` write it. One block per Neon branch:
# main (production), dev (local development), test (local tests and CI).
JARVIS_NEON_PROJECT_ID=
# The application role (LOGIN NOBYPASSRLS), same password on every branch.
JARVIS_APP_PASSWORD=

# Branch test (the same keys exist for MAIN and DEV)
JARVIS_TEST_BRANCH_ID=
# The owner runs migrations; the application connects as jarvis_app.
JARVIS_TEST_OWNER_URL=postgresql://neondb_owner:...@host/neondb?sslmode=require
JARVIS_TEST_APP_URL=postgresql://jarvis_app:...@host/neondb?sslmode=require
# Neon Object Storage of the branch: its S3 endpoint, region, bucket and scoped credential.
JARVIS_TEST_STORAGE_ENDPOINT=https://br-....storage....eu-central-1.aws.neon.tech
JARVIS_TEST_STORAGE_REGION=eu-central-1
JARVIS_TEST_STORAGE_BUCKET=files
JARVIS_TEST_STORAGE_ACCESS_KEY_ID=
JARVIS_TEST_STORAGE_SECRET_ACCESS_KEY=

# Accounts: one secret per environment, at least 32 characters.
JARVIS_DEV_AUTH_SECRET=
JARVIS_TEST_AUTH_SECRET=

# Behind an antivirus that inspects HTTPS (Kaspersky, ESET…): its root certificate, as PEM.
# NODE_EXTRA_CA_CERTS=C:\path\to\antivirus-root.pem

# Serving from this machine (`pnpm serve`): the fixed ngrok domain of the author's account.
JARVIS_TUNNEL_DOMAIN=
# Deploying (`pnpm deploy:draft`, `pnpm deploy:prod`, spec 010): the Netlify site's id (not a
# secret). The Netlify token stays in ../.secrets/.admin.env (NETLIFY_AUTH_TOKEN).
JARVIS_NETLIFY_SITE=
# The watcher's Telegram bot (spec 006): its token, and the chat it writes to by default.
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=
# E-mail (spec 020): any SMTP server, as a URL (smtps://user:password@host:465), and the sender
# (« Jarvis <jarvis@your-domain> »). Without them, messages go by Telegram only.
JARVIS_SMTP_URL=
JARVIS_EMAIL_FROM=
# Who may make an account (spec 024): « open » (default) or « invite »; with « invite », addresses
# or « @domain » let in without an invitation, comma-separated.
JARVIS_SIGNUP=
JARVIS_SIGNUP_ALLOW=
# Google's own MCP servers (Drive, Gmail, Agenda; spec 025) ask a client registered once in
# Google Cloud; its redirect address is <public address>/api/connectors/callback.
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
