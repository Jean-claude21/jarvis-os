{
  "app": "Candidatures",
  "version": 1,
  "description": {
    "fr": "Chercher un stage, une alternance ou un emploi : ce que tu cherches et tes mots, les sites où chercher et leur recette, les offres ramenées chaque matin et notées, tes candidatures et leurs relances.",
    "en": "Looking for an internship, a work-study place or a job: what you look for and your words, the sites to search and their recipe, the offers brought back each morning and scored, your applications and follow-ups."
  },
  "models": [
    {
      "title": "JobSearch",
      "data": {
        "label": {
          "fr": "Profil de recherche",
          "en": "Job search"
        },
        "fields": [
          {
            "name": "poste",
            "type": "text",
            "required": true,
            "label": {
              "fr": "Poste recherché",
              "en": "Role"
            },
            "help": "Les mots de l’offre : « stage intelligence artificielle »",
            "aliases": ["query", "role", "job"]
          },
          {
            "name": "mots",
            "type": "long_text",
            "label": {
              "fr": "Mes mots",
              "en": "My words"
            },
            "help": "Une idée par ligne, ses façons de la dire séparées par | : intelligence artificielle|IA|AI|machine learning",
            "aliases": ["words", "keywords", "mots_cles"]
          },
          {
            "name": "lieu",
            "type": "text",
            "label": {
              "fr": "Lieu",
              "en": "Place"
            },
            "default": "France",
            "aliases": ["location", "ville"]
          },
          {
            "name": "contrat",
            "type": "choice",
            "label": {
              "fr": "Contrat",
              "en": "Contract"
            },
            "options": ["stage", "alternance", "cdi", "cdd", "freelance"],
            "optionLabels": {
              "stage": {
                "fr": "Stage",
                "en": "Internship"
              },
              "alternance": {
                "fr": "Alternance",
                "en": "Work-study"
              },
              "cdi": {
                "fr": "CDI",
                "en": "Permanent"
              },
              "cdd": {
                "fr": "CDD",
                "en": "Fixed-term"
              },
              "freelance": {
                "fr": "Freelance",
                "en": "Freelance"
              }
            },
            "aliases": ["contract"]
          },
          {
            "name": "debut",
            "type": "date",
            "label": {
              "fr": "À partir du",
              "en": "From"
            }
          },
          {
            "name": "types",
            "type": "long_text",
            "label": {
              "fr": "Types",
              "en": "Types"
            },
            "help": "Un type par ligne et ses mots : « stage: stage|stagiaire|intern ».",
            "default": "stage: stage|stagiaire|intern|internship\nalternance: alternance|alternant|apprentissage|apprenti\ncdi: cdi"
          }
        ],
        "columns": ["poste", "lieu", "contrat", "mots"]
      }
    },
    {
      "title": "Source",
      "data": {
        "label": {
          "fr": "Source",
          "en": "Source"
        },
        "fields": [
          {
            "name": "lien",
            "type": "url",
            "label": {
              "fr": "Lien",
              "en": "Link"
            },
            "help": "Le site, prêt à ouvrir (une recherche déjà remplie)."
          },
          {
            "name": "url",
            "type": "text",
            "label": {
              "fr": "Adresse de recherche",
              "en": "Search address"
            },
            "help": "Ses {champs} prennent la valeur de chaque recherche : https://site/recherche?q={poste}&l={lieu}"
          },
          {
            "name": "active",
            "type": "boolean",
            "default": true,
            "label": {
              "fr": "Parcourue chaque matin",
              "en": "Read every morning"
            },
            "help": "Non : un site à ouvrir soi-même (il bloque les robots ou demande un compte) — gardé ici avec son lien."
          },
          {
            "name": "js",
            "type": "boolean",
            "label": {
              "fr": "Construite par script",
              "en": "Built by script"
            },
            "default": false
          },
          {
            "name": "recipe",
            "type": "long_text",
            "label": {
              "fr": "Recette",
              "en": "Recipe"
            },
            "help": "Écrite par l’IA (JSON) : schema { base, fields }, treg { route, body }, rename",
            "aliases": ["recette"]
          },
          {
            "name": "notes",
            "type": "long_text",
            "label": {
              "fr": "Notes",
              "en": "Notes"
            }
          }
        ],
        "columns": ["lien", "active", "notes"]
      }
    },
    {
      "title": "JobOffer",
      "data": {
        "label": {
          "fr": "Offre",
          "en": "Job offer"
        },
        "fields": [
          {
            "name": "company",
            "type": "text",
            "label": {
              "fr": "Entreprise",
              "en": "Company"
            }
          },
          {
            "name": "location",
            "type": "text",
            "label": {
              "fr": "Lieu",
              "en": "Place"
            }
          },
          {
            "name": "url",
            "type": "url",
            "unique": true,
            "label": {
              "fr": "Voir l’offre",
              "en": "See the offer"
            }
          },
          {
            "name": "published",
            "type": "date",
            "label": {
              "fr": "Publiée le",
              "en": "Published"
            }
          },
          {
            "name": "contract",
            "type": "text",
            "label": {
              "fr": "Contrat",
              "en": "Contract"
            }
          },
          {
            "name": "type",
            "type": "choice",
            "label": {
              "fr": "Type",
              "en": "Type"
            },
            "options": ["stage", "alternance", "cdi", "autre"],
            "optionLabels": {
              "stage": {
                "fr": "stage",
                "en": "internship"
              },
              "alternance": {
                "fr": "alternance",
                "en": "work-study"
              },
              "cdi": {
                "fr": "CDI",
                "en": "permanent"
              },
              "autre": {
                "fr": "autre",
                "en": "other"
              }
            }
          },
          {
            "name": "source",
            "type": "text",
            "label": {
              "fr": "Source",
              "en": "Source"
            }
          },
          {
            "name": "score",
            "type": "number",
            "min": 0,
            "max": 100,
            "label": {
              "fr": "Score",
              "en": "Score"
            }
          },
          {
            "name": "reasons",
            "type": "text",
            "label": {
              "fr": "Pourquoi",
              "en": "Why"
            }
          },
          {
            "name": "status",
            "type": "choice",
            "label": {
              "fr": "Suite",
              "en": "Next"
            },
            "options": ["new", "interesting", "applied", "dismissed"],
            "optionLabels": {
              "new": {
                "fr": "nouvelle",
                "en": "new"
              },
              "interesting": {
                "fr": "à creuser",
                "en": "interesting"
              },
              "applied": {
                "fr": "postulée",
                "en": "applied"
              },
              "dismissed": {
                "fr": "écartée",
                "en": "dismissed"
              }
            },
            "default": "new"
          },
          {
            "name": "position",
            "type": "location",
            "label": {
              "fr": "Position",
              "en": "Position"
            }
          },
          {
            "name": "empreinte",
            "type": "text",
            "label": {
              "fr": "Empreinte",
              "en": "Fingerprint"
            },
            "help": "Mots du titre + entreprise : la même offre vue sur plusieurs sites ou plusieurs jours."
          },
          {
            "name": "contenu",
            "type": "long_text",
            "label": {
              "fr": "Contenu de l’offre",
              "en": "Offer’s content"
            },
            "help": "Le texte complet de la page de l’offre, lu sans IA chaque matin, pour que l’IA le lise."
          },
          {
            "name": "adequation",
            "type": "number",
            "min": 0,
            "max": 100,
            "label": {
              "fr": "Adéquation (IA)",
              "en": "Fit (AI)"
            },
            "help": "L’IA lit le contenu et ton CV maître : à quel point l’offre te correspond, sur 100."
          },
          {
            "name": "avis_ia",
            "type": "long_text",
            "label": {
              "fr": "Avis de l’IA",
              "en": "AI’s review"
            }
          }
        ],
        "columns": ["url", "company", "location", "type", "score", "status"]
      }
    },
    {
      "title": "Application",
      "data": {
        "label": {
          "fr": "Candidature",
          "en": "Application"
        },
        "activity": true,
        "fields": [
          {
            "name": "offer",
            "type": "link",
            "target": "JobOffer",
            "inverse": "applications",
            "label": {
              "fr": "Offre",
              "en": "Offer"
            }
          },
          {
            "name": "company",
            "type": "text",
            "label": {
              "fr": "Entreprise",
              "en": "Company"
            }
          },
          {
            "name": "status",
            "type": "choice",
            "label": {
              "fr": "Où j’en suis",
              "en": "Where it stands"
            },
            "options": ["to_send", "waiting", "interview", "done"],
            "optionLabels": {
              "to_send": {
                "fr": "à envoyer",
                "en": "to send"
              },
              "waiting": {
                "fr": "envoyée, en attente",
                "en": "sent, waiting"
              },
              "interview": {
                "fr": "entretien",
                "en": "interview"
              },
              "done": {
                "fr": "terminée",
                "en": "over"
              }
            },
            "default": "to_send"
          },
          {
            "name": "sent_on",
            "type": "date",
            "label": {
              "fr": "Envoyée le",
              "en": "Sent on"
            }
          },
          {
            "name": "due",
            "type": "date",
            "label": {
              "fr": "Relancer le",
              "en": "Follow up on"
            },
            "aliases": ["relance", "next_step"]
          },
          {
            "name": "outcome",
            "type": "choice",
            "label": {
              "fr": "Réponse",
              "en": "Answer"
            },
            "options": ["none", "yes", "no"],
            "optionLabels": {
              "none": {
                "fr": "pas encore",
                "en": "not yet"
              },
              "yes": {
                "fr": "acceptée",
                "en": "accepted"
              },
              "no": {
                "fr": "refusée",
                "en": "declined"
              }
            },
            "default": "none"
          },
          {
            "name": "contact",
            "type": "text",
            "label": {
              "fr": "Contact",
              "en": "Contact"
            }
          },
          {
            "name": "notes",
            "type": "long_text",
            "label": {
              "fr": "Notes",
              "en": "Notes"
            }
          }
        ],
        "columns": ["company", "status", "sent_on", "due", "outcome"]
      }
    },
    {
      "title": "CV",
      "data": {
        "label": {
          "fr": "CV",
          "en": "CV"
        },
        "fields": [
          {
            "name": "role",
            "type": "choice",
            "label": {
              "fr": "Rôle",
              "en": "Role"
            },
            "options": ["master", "tailored", "template"],
            "optionLabels": {
              "master": {
                "fr": "CV maître",
                "en": "master CV"
              },
              "tailored": {
                "fr": "adapté à une offre",
                "en": "tailored to an offer"
              },
              "template": {
                "fr": "modèle de mise en page",
                "en": "layout template"
              }
            },
            "default": "tailored"
          },
          {
            "name": "offer",
            "type": "link",
            "target": "JobOffer",
            "inverse": "cvs",
            "label": {
              "fr": "Offre",
              "en": "Offer"
            }
          },
          {
            "name": "content",
            "type": "long_text",
            "label": {
              "fr": "Contenu",
              "en": "Content"
            },
            "help": "Maître et adapté : Markdown. Modèle : une page HTML avec {{contenu}}."
          },
          {
            "name": "appreciation",
            "type": "number",
            "min": 0,
            "max": 100,
            "label": {
              "fr": "Appréciation de l’IA",
              "en": "AI appraisal"
            }
          },
          {
            "name": "avis",
            "type": "long_text",
            "label": {
              "fr": "Avis",
              "en": "Review"
            }
          },
          {
            "name": "state",
            "type": "choice",
            "label": {
              "fr": "État",
              "en": "State"
            },
            "options": ["draft", "ready", "sent"],
            "optionLabels": {
              "draft": {
                "fr": "brouillon",
                "en": "draft"
              },
              "ready": {
                "fr": "prêt (PDF)",
                "en": "ready (PDF)"
              },
              "sent": {
                "fr": "envoyé",
                "en": "sent"
              }
            },
            "default": "draft"
          }
        ],
        "columns": ["role", "offer", "state", "appreciation"]
      }
    },
    {
      "title": "Criterion",
      "data": {
        "label": {
          "fr": "Critère de CV",
          "en": "CV criterion"
        },
        "fields": [
          {
            "name": "poids",
            "type": "number",
            "min": 0,
            "max": 100,
            "label": {
              "fr": "Poids",
              "en": "Weight"
            }
          },
          {
            "name": "instruction",
            "type": "long_text",
            "label": {
              "fr": "Ce que l’IA vérifie",
              "en": "What the AI checks"
            }
          },
          {
            "name": "ordre",
            "type": "number",
            "label": {
              "fr": "Ordre",
              "en": "Order"
            }
          }
        ],
        "columns": ["poids", "instruction"]
      }
    }
  ],
  "pages": [
    {
      "title": "Applications",
      "data": {
        "label": {
          "fr": "Aujourd’hui",
          "en": "Today"
        },
        "order": 1,
        "filters": [
          {
            "name": "type",
            "type": "choice",
            "options": ["tous", "stage", "alternance", "cdi", "autre"],
            "default": "tous",
            "label": {
              "fr": "Type",
              "en": "Type"
            }
          }
        ],
        "blocks": [
          {
            "block": "stat",
            "title": {
              "fr": "Nouvelles en IA",
              "en": "New on AI"
            },
            "query": {
              "kind": "JobOffer",
              "where": "status = 'new' and score >= 100 and ({type} = 'tous' or type = {type})",
              "aggregate": {
                "n": "count()"
              }
            }
          },
          {
            "block": "stat",
            "title": {
              "fr": "À creuser",
              "en": "To look into"
            },
            "query": {
              "kind": "JobOffer",
              "where": "status = 'interesting' and ({type} = 'tous' or type = {type})",
              "aggregate": {
                "n": "count()"
              }
            }
          },
          {
            "block": "stat",
            "title": {
              "fr": "CV prêts",
              "en": "CVs ready"
            },
            "query": {
              "kind": "CV",
              "where": "state = 'ready'",
              "aggregate": {
                "n": "count()"
              }
            }
          },
          {
            "block": "stat",
            "title": {
              "fr": "Candidatures en cours",
              "en": "Applications under way"
            },
            "query": {
              "kind": "Application",
              "where": "status != 'done'",
              "aggregate": {
                "n": "count()"
              }
            }
          },
          {
            "block": "table",
            "title": {
              "fr": "Dernière collecte",
              "en": "Last collection"
            },
            "query": {
              "kind": "Execution",
              "where": "service = 'Atelier'",
              "fields": ["status", "started", "error"],
              "sort": "-started",
              "limit": 1
            }
          },
          {
            "block": "review",
            "title": {
              "fr": "Nouvelles offres, une à une",
              "en": "New offers, one by one"
            },
            "kind": "JobOffer",
            "where": "status = 'new' and score >= 100 and ({type} = 'tous' or type = {type})",
            "subtitle": ["company", "location"],
            "badge": "score",
            "fields": [
              "adequation",
              "avis_ia",
              "company",
              "location",
              "type",
              "contract",
              "published",
              "source",
              "reasons",
              "contenu"
            ],
            "facets": ["type", "source"],
            "link": "url",
            "sort": "-published",
            "action": {
              "label": "À creuser",
              "set": {
                "status": "interesting"
              }
            },
            "more": [
              {
                "label": "Postulé",
                "set": {
                  "status": "applied"
                }
              },
              {
                "label": "Écarter",
                "set": {
                  "status": "dismissed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Offers",
      "data": {
        "label": {
          "fr": "Offres",
          "en": "Offers"
        },
        "order": 2,
        "blocks": [
          {
            "block": "datatable",
            "title": {
              "fr": "Toutes mes offres en IA",
              "en": "All my AI offers"
            },
            "kind": "JobOffer",
            "where": "score >= 100",
            "columns": [
              "company",
              "location",
              "type",
              "status",
              "score",
              "adequation",
              "published",
              "url"
            ],
            "facets": ["type", "status", "source", "location"],
            "link": "url",
            "sort": "-published",
            "action": {
              "label": "À creuser",
              "set": {
                "status": "interesting"
              }
            },
            "more": [
              {
                "label": "Postulé",
                "set": {
                  "status": "applied"
                }
              },
              {
                "label": "Écarter",
                "set": {
                  "status": "dismissed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Tracking",
      "data": {
        "label": {
          "fr": "Suivi",
          "en": "Tracking"
        },
        "order": 3,
        "filters": [
          {
            "name": "type",
            "type": "choice",
            "options": ["tous", "stage", "alternance", "cdi", "autre"],
            "default": "tous",
            "label": {
              "fr": "Type",
              "en": "Type"
            }
          }
        ],
        "blocks": [
          {
            "block": "funnel",
            "title": {
              "fr": "Où en sont mes offres",
              "en": "Where my offers stand"
            },
            "kind": "JobOffer",
            "where": "score >= 100 and ({type} = 'tous' or type = {type})",
            "by": "status",
            "steps": ["new", "interesting", "applied"]
          },
          {
            "block": "breakdown",
            "title": {
              "fr": "Par type",
              "en": "By type"
            },
            "query": {
              "kind": "JobOffer",
              "where": "score >= 100 and status != 'dismissed'",
              "groupBy": "type",
              "aggregate": {
                "n": "count()"
              }
            }
          },
          {
            "block": "bar",
            "title": {
              "fr": "Ce que chaque site m’apporte",
              "en": "What each site brings"
            },
            "query": {
              "kind": "JobOffer",
              "where": "score >= 100 and status != 'dismissed' and ({type} = 'tous' or type = {type})",
              "groupBy": "source",
              "aggregate": {
                "n": "count()"
              },
              "sort": "-n",
              "limit": 12
            }
          },
          {
            "block": "kanban",
            "title": {
              "fr": "Mes offres en IA",
              "en": "My AI offers"
            },
            "kind": "JobOffer",
            "by": "status",
            "where": "score >= 100 and ({type} = 'tous' or type = {type})",
            "detail": "company",
            "badge": "score",
            "link": "url",
            "muted": ["dismissed"],
            "show": ["interesting", "applied", "dismissed"]
          },
          {
            "block": "kanban",
            "title": {
              "fr": "Candidatures",
              "en": "Applications"
            },
            "kind": "Application",
            "by": "status"
          },
          {
            "block": "calendar",
            "title": {
              "fr": "Les jours qui viennent",
              "en": "Days ahead"
            },
            "days": 14
          }
        ]
      }
    },
    {
      "title": "CVs",
      "data": {
        "label": {
          "fr": "CV",
          "en": "CVs"
        },
        "order": 4,
        "blocks": [
          {
            "block": "datatable",
            "title": {
              "fr": "Mes CV",
              "en": "My CVs"
            },
            "kind": "CV",
            "columns": ["role", "offer", "state", "appreciation"],
            "facets": ["role", "state"]
          },
          {
            "block": "table",
            "title": {
              "fr": "Ma grille d’appréciation des CV",
              "en": "My CV grid"
            },
            "query": {
              "kind": "Criterion",
              "fields": ["poids", "instruction"],
              "sort": "ordre"
            }
          }
        ]
      }
    },
    {
      "title": "Settings",
      "data": {
        "label": {
          "fr": "Réglages",
          "en": "Settings"
        },
        "order": 5,
        "blocks": [
          {
            "block": "datatable",
            "title": {
              "fr": "Ce que je cherche",
              "en": "What I am looking for"
            },
            "kind": "JobSearch",
            "columns": ["poste", "lieu", "contrat"]
          },
          {
            "block": "datatable",
            "title": {
              "fr": "Où je cherche",
              "en": "Where I search"
            },
            "kind": "Source",
            "where": "lien != null",
            "columns": ["lien", "active", "notes"],
            "facets": ["active"],
            "link": "lien"
          },
          {
            "block": "form",
            "title": {
              "fr": "Ajouter une recherche",
              "en": "Add a search"
            },
            "kind": "JobSearch"
          }
        ]
      }
    }
  ],
  "rules": [
    {
      "title": "Offres du matin",
      "data": {
        "when": {
          "schedule": "0 7 * * *"
        },
        "then": [
          {
            "call": {
              "connection": "Atelier",
              "path": "/jobs/parcourir",
              "include": {
                "searches": "JobSearch",
                "sources": "Source"
              },
              "save": {
