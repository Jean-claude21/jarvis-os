{
  "app": "Routines",
  "version": 1,
  "description": "Habitudes avec leur cadence dans l'agenda, pointages, séries et taux de régularité ; la semaine et la régularité en un coup d'œil, un rappel quand une habitude non négociable n'est pas pointée.",
  "models": [
    {
      "title": "Habitude",
      "data": {
        "fields": [
          {
            "name": "repeat",
            "type": "text",
            "help": "La cadence en cinq champs (« 30 18 * * 2,3 ») : elle met l'habitude dans l'agenda."
          },
          { "name": "duration", "type": "duration" },
          {
            "name": "aspect",
            "type": "choice",
            "options": ["esprit", "âme", "corps", "relations", "travail"]
          },
          { "name": "non_negociable", "type": "boolean" },
          { "name": "serie", "type": "formula", "formula": "streak(pointages.date)" },
          {
            "name": "taux_30j",
            "type": "formula",
            "formula": "round(count(pointages where last_days(date, 30)) / 30 * 100)"
          },
          { "name": "dernier", "type": "formula", "formula": "max(pointages.date)" }
        ],
        "columns": ["aspect", "serie", "taux_30j", "dernier"],
        "path": "routines/habitudes/{title}.md"
      }
    },
    {
      "title": "Pointage",
      "data": {
        "fields": [
          { "name": "date", "type": "date", "required": true },
          {
            "name": "habitude",
            "type": "link",
            "target": "Habitude",
            "inverse": "pointages",
            "required": true
          },
          { "name": "note", "type": "text" }
        ],
        "columns": ["date"],
        "path": "routines/{year}/{month}/{date}-{title}.md"
      }
    }
  ],
  "pages": [
    {
      "title": "Ma régularité",
      "data": {
        "order": 1,
        "blocks": [
          { "block": "calendar", "title": "Cette semaine", "days": 7 },
          {
            "block": "gauge",
            "title": "Régularité sur 30 jours (%)",
            "kind": "Habitude",
            "value": "taux_30j",
            "max": "100"
          },
          { "block": "heatmap", "title": "Jours pointés", "kind": "Pointage", "days": 35 },
          {
            "block": "table",
            "title": "Habitudes",
            "query": {
              "kind": "Habitude",
              "fields": ["aspect", "serie", "taux_30j", "dernier"],
              "sort": "-serie"
            }
          },
          { "block": "form", "title": "Pointer", "kind": "Pointage" }
        ]
      }
    }
  ],
  "rules": [
    {
      "title": "Non négociable oublié",
      "data": {
        "when": { "schedule": "0 21 * * *" },
        "then": [{ "run_script": { "script": "Habitudes du jour" } }]
      }
    }
  ],
  "scripts": [
    {
      "title": "Habitudes du jour",
      "data": {
        "description": "Le soir : un rappel pour chaque habitude non négociable qui n'a pas été pointée aujourd'hui.",
        "reads": ["Habitude"],
        "writes": ["Rappel"],
        "code": "function run(input) {\n  return input.entries.Habitude\n    .filter((h) => h.data.non_negociable && h.computed.dernier !== input.today)\n    .map((h) => ({ remind: { text: 'Pas encore fait aujourd\\'hui : ' + h.title } }));\n}"
      }
    }
  ]
}
