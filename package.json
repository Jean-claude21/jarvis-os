{
  "name": "jarvis-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "provision": "tsx tooling/provision.ts",
    "serve": "tsx tooling/serve.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
